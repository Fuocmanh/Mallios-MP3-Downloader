{
  "manifest_version": 3,
  "name": "Mallios MP3 Downloader",
  "version": "3.7",
  "key": "",
  "description": "Tải audio YouTube thành MP3 qua Mallios local server.",
  "permissions": [
    "storage",
    "nativeMessaging",
    "identity",
    "notifications",
    "contextMenus"
  ],
  "oauth2": {
    "client_id": "758509378393-cl3d0a9n3g87iukck10e30g49uphq0g5.apps.googleusercontent.com",
    "scopes": [
      "https://www.googleapis.com/auth/drive.file",
      "https://www.googleapis.com/auth/userinfo.email"
    ]
  },
  "background": {
    "service_worker": "background.js"
  },
  "host_permissions": [
    "http://127.0.0.1:5000/*",
    "http://127.0.0.1:37491/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://www.youtube.com/*",
        "https://music.youtube.com/*",
        "https://soundcloud.com/*"
      ],
      "css": [
        "content/content.css"
      ],
      "js": [
        "content/content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "icons/bear-icon.png",
    "48": "icons/bear-icon.png",
    "128": "icons/bear-icon.png"
  }
}